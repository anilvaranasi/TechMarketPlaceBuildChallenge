        <list_link>false</list_link>
        <list_save_with_form_button>false</list_save_with_form_button>
        <list_style/>
        <messages/>
        <name>Advance Stage</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[
        var currentStage = current.getValue('onboarding_stage');
        var nextStage = '';
        
        switch (currentStage) {
            case 'registration':
                nextStage = 'review';
                break;
            case 'review':
                nextStage = 'documentation';
                break;
            case 'documentation':
                nextStage = 'technical_setup';
                break;
            case 'technical_setup':
                nextStage = 'testing';
                break;
            case 'testing':
                nextStage = 'approval';
                break;
            case 'approval':
                nextStage = 'complete';
                break;
        }
        
        if (nextStage) {
            current.setValue('onboarding_stage', nextStage);
            current.update();
            gs.addInfoMessage('Onboarding stage advanced to: ' + nextStage);
        }
        
        action.setRedirectURL(current);
    ]]></script>
